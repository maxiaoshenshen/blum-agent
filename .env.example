# OpenAI-compatible Chat Completions endpoint, without a trailing slash.
PROVIDER_BASE_URL=https://your-provider.example

# Keep the real value in .env.local or the hosting provider's secret store.
PROVIDER_API_KEY=

# Model exposed by the configured provider.
PROVIDER_MODEL=claude-opus-5

# Canonical HTTPS origin used in social sharing metadata.
PUBLIC_SITE_URL=https://blum-agent.example.com
